# Backend: copie para .env.local apenas se ele ainda não existir.
DATABASE_URL=postgresql://USUARIO:SENHA@HOST-POOLER.neon.tech/DB?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://USUARIO:SENHA@HOST.neon.tech/DB?sslmode=require
# Opcional. O script gera uma chave de sessão quando este valor está vazio.
JWT_SECRET=

# SMTP opcional para recuperação de senha e avisos de conta.
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_AUTH=true
MAIL_TLS=true
MAIL_HEALTH_ENABLED=false

# Endereço do frontend que os destinatários conseguem abrir.
PUBLIC_URL=http://localhost:8081
