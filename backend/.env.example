# Referência para iniciar o Spring diretamente com variáveis de ambiente.
# O script start-neon.ps1 usa .env.local da raiz e converte as URLs.
SPRING_DATASOURCE_URL=jdbc:postgresql://HOST-POOLER.neon.tech:5432/DB?sslmode=verify-full&sslfactory=org.postgresql.ssl.DefaultJavaSSLFactory
SPRING_DATASOURCE_USERNAME=
SPRING_DATASOURCE_PASSWORD=
SPRING_FLYWAY_URL=jdbc:postgresql://HOST.neon.tech:5432/DB?sslmode=verify-full&sslfactory=org.postgresql.ssl.DefaultJavaSSLFactory
SPRING_FLYWAY_USER=
SPRING_FLYWAY_PASSWORD=
JWT_SECRET=
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_AUTH=true
MAIL_TLS=true
PUBLIC_URL=http://localhost:8081
FRONTEND_ORIGINS=http://localhost:8081,http://localhost:19006
